server {
    server_name commoneragame.com;
    root /var/www/commoneragame/dist;
    index index.html;
    location / {
				auth_basic "Public, but invite-only";
				auth_basic_user_file /var/www/public.anybody.htpasswd;
        try_files $uri $uri/ /index.html;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/commoneragame.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/commoneragame.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}

server {
    if ($host = commoneragame.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name commoneragame.com;
    return 404; # managed by Certbot


}